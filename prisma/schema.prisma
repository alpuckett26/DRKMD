generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Store {
  id                String    @id @default(cuid())
  name              String
  location          String?
  windowModeEnabled Boolean   @default(false)
  windowModeStart   String?
  windowModeEnd     String?
  timezone          String    @default("America/Chicago")
  logoUrl           String?
  onboardingComplete Boolean   @default(false)
  shelfRows          Int?
  shelfCols          Int?
  shelfAreas         Json?     @default("[]")
  ownerName          String?
  ownerEmail         String?
  phone              String?
  businessLegalName  String?
  businessType       String?
  ein                String?
  address            String?
  city               String?
  state              String?
  zip                String?
  tosAcceptedAt      DateTime?
  products          Product[]
  orders            Order[]
  staff             Staff[]
  account           Account?
  shelfPhotos       ShelfPhoto[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model ShelfPhoto {
  id            String   @id @default(cuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  imageUrl      String
  label         String?
  detections    Json
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)
  shelfIndex    Int?
  sectionIndex  Int?
  areaName      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([storeId, active, sortOrder])
  @@index([storeId, shelfIndex, sectionIndex])
}

model StoreRequest {
  id            String   @id @default(cuid())
  storeName     String
  city          String?
  state         String?
  address       String?
  ownerName     String?
  contactEmail  String?
  contactPhone  String?
  notes         String?
  status        String   @default("new")
  createdAt     DateTime @default(now())
}

model Account {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  storeId        String    @unique
  store          Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sessionToken   String?   @unique
  sessionExpires DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Staff {
  id             String       @id @default(cuid())
  storeId        String
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name           String
  role           StaffRole    @default(staff)
  pin            String
  active         Boolean      @default(true)
  failedAttempts Int          @default(0)
  lockedUntil    DateTime?
  sessionToken   String?      @unique
  sessionExpires DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  shifts         StaffShift[]
  events         OrderEvent[]
  orders         Order[]
}

model StaffShift {
  id         String    @id @default(cuid())
  staffId    String
  staff      Staff     @relation(fields: [staffId], references: [id])
  storeId    String
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  orderCount Int       @default(0)
  totalSales Int       @default(0)
}

enum StaffRole {
  admin
  staff
}

model Product {
  id                 String      @id @default(cuid())
  storeId            String
  store              Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name               String
  category           String?
  price              Int
  nighttimeAvailable Boolean     @default(true)
  restrictedFlag     Boolean     @default(false)
  imageUrl           String?
  active             Boolean     @default(true)
  promoted           Boolean     @default(false)
  availabilityStatus String      @default("available")
  similarProductIds  String[]    @default([])
  orderItems         OrderItem[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@unique([storeId, name])
}

model Order {
  id                     String                 @id @default(cuid())
  storeId                String
  store                  Store                  @relation(fields: [storeId], references: [id])
  customerName           String
  customerPhone          String?
  status                 OrderStatus            @default(submitted)
  estimatedTotal         Int
  finalTotal             Int?
  paymentAuthId          String?
  paymentCaptureId       String?
  substitutionPreference SubstitutionPreference @default(none)
  pickupCode             String
  pickupCodeQr           String?
  staffId                String?
  staff                  Staff?                 @relation(fields: [staffId], references: [id])
  createdAt              DateTime               @default(now())
  completedAt            DateTime?
  items                  OrderItem[]
  events                 OrderEvent[]
}

model OrderItem {
  id                 String     @id @default(cuid())
  orderId            String
  order              Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId          String?
  product            Product?   @relation(fields: [productId], references: [id])
  requestedName      String
  requestedPrice     Int
  qtyRequested       Int
  qtyFound           Int        @default(0)
  finalPrice         Int?
  status             ItemStatus @default(requested)
  substitutionReason String?
  createdAt          DateTime   @default(now())
}

model OrderEvent {
  id        String    @id @default(cuid())
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eventType EventType
  notes     String?
  staffId   String?
  staff     Staff?    @relation(fields: [staffId], references: [id])
  createdAt DateTime  @default(now())
}

enum OrderStatus {
  submitted
  authorized
  picking
  ready
  partially_ready
  captured
  completed
  voided
  canceled
}

enum ItemStatus {
  requested
  found
  unavailable
  substituted
  refused_restricted
}

enum SubstitutionPreference {
  none
  allow_similar
}

enum EventType {
  submitted
  authorized
  picking_started
  item_marked
  ready
  captured
  completed
  voided
  canceled
}
