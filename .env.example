# Database - Supabase (get from supabase.com > Project Settings > Database)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Square - get from developer.squareup.com > Applications
SQUARE_ACCESS_TOKEN="sandbox-sq0iieh-..."
SQUARE_LOCATION_ID="L..."
SQUARE_APPLICATION_ID="sandbox-sq0idb-..."
SQUARE_ENVIRONMENT="sandbox"   # or "production"

# Public env vars (exposed to browser — must be set in Vercel as NEXT_PUBLIC_)
NEXT_PUBLIC_SQUARE_APPLICATION_ID="sandbox-sq0idb-..."
NEXT_PUBLIC_SQUARE_LOCATION_ID="L..."
NEXT_PUBLIC_SQUARE_ENVIRONMENT="sandbox"  # or "production"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"  # prod: https://yourdomain.com

# Anthropic - get from console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."

# Google Custom Search (for product images) - get from console.cloud.google.com
GOOGLE_SEARCH_API_KEY="..."
GOOGLE_SEARCH_ENGINE_ID="..."

# Platform admin password (WendOS super-admin at /platform)
PLATFORM_ADMIN_PASSWORD="choose-a-strong-password"
